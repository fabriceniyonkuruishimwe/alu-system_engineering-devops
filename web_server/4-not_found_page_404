#!/usr/bin/env bash
# Installs nginx, sets a 301 redirect for /redirect_me and a custom 404 page
apt-get update -y
apt-get install -y nginx
echo "Hello World!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
if ! grep -q "location /redirect_me" /etc/nginx/sites-available/default; then
    sed -i "s|^[[:space:]]*location / {|\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}\n\n\tlocation / {|" /etc/nginx/sites-available/default
fi
if ! grep -q "error_page 404" /etc/nginx/sites-available/default; then
    sed -i "s|^[[:space:]]*location / {|\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}\n\n\tlocation / {|" /etc/nginx/sites-available/default
fi
service nginx restart
